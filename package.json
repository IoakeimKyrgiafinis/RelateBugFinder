{
  "name": "relate-bug-finder",
  "version": "0.1.0",
  "description": "Click a stack trace, get the ranked root-cause suspects. See who breaks before you refactor. A live code graph on Neo4j Relate, exposed to Copilot/Claude/Cursor over MCP.",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "package": "vsce package",
    "demo": "node demo/setup-demo.mjs demo-shop",
    "test:e2e": "node test/e2e.cjs demo-shop demo-shop/trace.txt",
    "package:all": "node scripts/package-all.mjs",
    "test": "node scripts/run-tests.mjs"
  },
  "keywords": [
    "stack trace",
    "root cause",
    "call graph",
    "impact analysis",
    "refactoring",
    "mcp",
    "neo4j",
    "relate",
    "cypher"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@relate/relate": "^1.1.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "displayName": "Relate Bug Finder — Error Trace & Impact Graph",
  "publisher": "ioakeimkyrgiafinis",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=18"
  },
  "categories": [
    "Debuggers",
    "Visualization",
    "AI"
  ],
  "bin": {
    "relate-bug-finder": "./dist/cli.js",
    "relate-bug-finder-mcp": "./dist/mcp.js"
  },
  "activationEvents": [
    "workspaceContains:**/*.{ts,tsx,js,jsx,py}",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "relateBugFinder.traceError",
        "title": "Trace Error: Find Root-Cause Suspects",
        "category": "Relate Bug Finder",
        "icon": "$(debug-alt)"
      },
      {
        "command": "relateBugFinder.blastRadius",
        "title": "Show Blast Radius of Function at Cursor",
        "category": "Relate Bug Finder",
        "icon": "$(references)"
      },
      {
        "command": "relateBugFinder.showPanel",
        "title": "Open Panel",
        "category": "Relate Bug Finder"
      },
      {
        "command": "relateBugFinder.reindex",
        "title": "Re-index Workspace",
        "category": "Relate Bug Finder"
      },
      {
        "command": "relateBugFinder.setupMcp",
        "title": "Register MCP Server for Claude Code / Cursor",
        "category": "Relate Bug Finder"
      },
      {
        "command": "relateBugFinder.showLog",
        "title": "Show Log",
        "category": "Relate Bug Finder"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "relateBugFinder.blastRadius",
          "group": "navigation@9",
          "when": "editorLangId =~ /typescript|javascript|python/"
        },
        {
          "command": "relateBugFinder.traceError",
          "group": "navigation@10",
          "when": "editorHasSelection"
        }
      ],
      "editor/title": [
        {
          "command": "relateBugFinder.traceError",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "relateBugFinder.traceError",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "relateBugFinder.blastRadius",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Relate Bug Finder",
      "properties": {
        "relateBugFinder.autoTraceTerminal": {
          "type": "boolean",
          "default": true,
          "description": "When a terminal command fails with a stack trace, rank root-cause suspects automatically."
        },
        "relateBugFinder.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show caller counts and recent-change markers above functions."
        },
        "relateBugFinder.maxSuspects": {
          "type": "number",
          "default": 10,
          "description": "Suspects to show per trace."
        },
        "relateBugFinder.gitHistoryDays": {
          "type": "number",
          "default": 30,
          "description": "How far back to read git history."
        },
        "relateBugFinder.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable for indexing .py files (default: python3 / python)."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "relateBugFinder.mcp",
        "label": "Relate Bug Finder code graph"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IoakeimKyrgiafinis/RelateBugFinder"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  }
}
